<% content_for :title, "Edit Stock" %>

<div class="max-w-lg">
  <div class="mb-6 flex items-center gap-3">
    <%= link_to @stock, class: "flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
      </svg>
      <%= @stock.description.upcase %>
    <% end %>
    <span class="text-gray-300">/</span>
    <span class="text-sm font-medium text-gray-900">Edit</span>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <h1 class="text-lg font-semibold text-gray-900 mb-5">Edit Stock</h1>
    <%= render "form", stock: @stock %>
  </div>
</div>
