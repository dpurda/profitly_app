<div id="<%= dom_id stock %>">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-gray-900"><%= stock.description.upcase %></h1>
    <p class="text-sm text-gray-500 mt-0.5"><%= stock.stock_date %></p>
  </div>

  <%
    total_p = 0
    total_s = 0
    stock.products.each do |product|
      total_p += product.in_price.to_d
      total_s += product.out_price.to_d if product.out_price.present?
    end
    profit = total_s - total_p
  %>

  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= t("stock.purchase") %></p>
      <p class="mt-1.5 text-xl font-bold text-gray-900"><%= number_to_currency(total_p, unit: '') %></p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= t("stock.revenue") %></p>
      <p class="mt-1.5 text-xl font-bold text-gray-900"><%= number_to_currency(total_s, unit: '') %></p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= t("stock.profit") %></p>
      <p class="mt-1.5 text-xl font-bold <%= profit >= 0 ? 'text-emerald-600' : 'text-red-600' %>">
        <%= profit >= 0 ? '+' : '' %><%= number_to_currency(profit, unit: '') %>
      </p>
    </div>
  </div>

  <% if stock.products.any? %>
    <div class="flex gap-3 mb-5">
      <div class="flex-1 flex items-center bg-white border border-gray-300 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-transparent">
        <div class="px-3 text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
          </svg>
        </div>
        <input type="text" id="product-search-<%= stock.id %>" placeholder="<%= t("stock.search_placeholder") %>" class="flex-1 py-2.5 text-sm focus:outline-none bg-transparent" aria-label="<%= t("stock.search_placeholder") %>">
      </div>
      <%= link_to new_product_path(stock_id: stock.id), class: "flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shrink-0" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        <%= t("stock.add_product") %>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50">
              <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide px-4 py-3"><%= t("stock.description") %></th>
              <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wide px-4 py-3"><%= t("stock.purchase") %></th>
              <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wide px-4 py-3"><%= t("stock.sale") %></th>
              <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide px-4 py-3"><%= t("stock.size") %></th>
              <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide px-4 py-3"><%= t("stock.code") %></th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 product-list-<%= stock.id %>">
            <% (defined?(@products) ? @products : stock.products).each do |product| %>
              <tr class="hover:bg-gray-50 transition-colors product-row" data-description="<%= product.description.downcase %>" data-size="<%= product.size.downcase %>" data-code="<%= product.prod_code&.downcase %>">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full shrink-0 <%= product.out_price.present? ? 'bg-emerald-400' : 'bg-gray-300' %>"></span>
                    <span class="text-sm text-gray-900"><%= product.description %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-right text-sm text-gray-700"><%= number_to_currency(product.in_price, unit: '') %></td>
                <td class="px-4 py-3 text-right text-sm <%= product.out_price.present? ? 'text-emerald-600 font-medium' : 'text-gray-400' %>">
                  <%= product.out_price.present? ? number_to_currency(product.out_price, unit: '') : '—' %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-700"><%= product.size.upcase %></td>
                <td class="px-4 py-3 text-xs text-gray-500 font-mono"><%= product.prod_code %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_product_path(product), class: "p-1.5 rounded-md text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                        <path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z" />
                        <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z" />
                      </svg>
                    <% end %>
                    <%= button_to product, method: :delete,
                        class: "p-1.5 rounded-md text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors",
                        form: { data: { turbo_confirm: t("stock.delete_product_confirm") } } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="md:hidden divide-y divide-gray-100 product-list-mobile-<%= stock.id %>">
        <% (defined?(@products) ? @products : stock.products).each do |product| %>
          <div class="p-4 product-card" data-description="<%= product.description.downcase %>" data-size="<%= product.size.downcase %>" data-code="<%= product.prod_code&.downcase %>">
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-2.5 flex-1 min-w-0">
                <span class="w-2 h-2 rounded-full mt-1.5 shrink-0 <%= product.out_price.present? ? 'bg-emerald-400' : 'bg-gray-300' %>"></span>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-gray-900 text-sm"><%= product.description %></p>
                  <div class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-sm text-gray-500">
                    <span><%= t("stock.buy") %>: <%= number_to_currency(product.in_price, unit: '') %></span>
                    <span class="<%= product.out_price.present? ? 'text-emerald-600 font-medium' : '' %>">
                      <%= t("stock.sell") %>: <%= product.out_price.present? ? number_to_currency(product.out_price, unit: '') : '—' %>
                    </span>
                    <span><%= t("stock.size") %>: <%= product.size.upcase %></span>
                    <span class="font-mono text-xs"><%= product.prod_code %></span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1 ml-3 shrink-0">
                <%= link_to edit_product_path(product), class: "p-1.5 rounded-md text-gray-400 hover:text-indigo-600" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                    <path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z" />
                    <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z" />
                  </svg>
                <% end %>
                <%= button_to product, method: :delete,
                    class: "p-1.5 rounded-md text-gray-400 hover:text-red-600",
                    form: { data: { turbo_confirm: t("stock.delete_product_confirm") } } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6 text-gray-400">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
      </div>
      <p class="text-gray-500 text-sm mb-4"><%= t("stock.no_products") %></p>
      <%= link_to new_product_path(stock_id: stock.id), class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        <%= t("stock.add_first") %>
      <% end %>
    </div>
  <% end %>
</div>

<% if stock.products.any? %>
  <script>
    (function() {
      function setupProductSearch() {
        const searchInput = document.getElementById('product-search-<%= stock.id %>');
        if (!searchInput) return;
        const newInput = searchInput.cloneNode(true);
        searchInput.parentNode.replaceChild(newInput, searchInput);
        newInput.addEventListener('input', function() {
          const term = this.value.toLowerCase().trim();
          document.querySelectorAll('.product-list-<%= stock.id %> .product-row').forEach(row => {
            const match = row.dataset.description.includes(term) || row.dataset.size.includes(term) || (row.dataset.code && row.dataset.code.includes(term));
            row.style.display = match ? '' : 'none';
          });
          document.querySelectorAll('.product-list-mobile-<%= stock.id %> .product-card').forEach(card => {
            const match = card.dataset.description.includes(term) || card.dataset.size.includes(term) || (card.dataset.code && card.dataset.code.includes(term));
            card.style.display = match ? '' : 'none';
          });
        });
      }
      document.addEventListener('DOMContentLoaded', setupProductSearch);
      document.addEventListener('turbo:load', setupProductSearch);
      setupProductSearch();
    })();
  </script>
<% end %>
