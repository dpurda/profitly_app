<aside id="sidebar" class="fixed md:static inset-y-0 left-0 z-30 w-64 bg-gray-900 flex flex-col shrink-0 transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out">
  <div class="flex items-center h-16 px-6 border-b border-gray-800 shrink-0">
    <%= link_to root_path, class: "font-bold text-white text-xl tracking-tight" do %>
      Profitly
    <% end %>
  </div>

  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <%= link_to stocks_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-lg transition-colors #{request.path.start_with?('/stocks') || request.path.start_with?('/products') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-3 shrink-0">
        <path fill-rule="evenodd" d="M.99 5.24A2.25 2.25 0 013.25 3h13.5A2.25 2.25 0 0119 5.25l.01 9.5A2.25 2.25 0 0116.76 17H3.26A2.272 2.272 0 011 14.74l-.01-9.5zm8.26 9.52v-.001a.75.75 0 00.75.75h4.76a.75.75 0 000-1.5H9.74v.001a.75.75 0 00-.49.75zm-2.95-2.524a.75.75 0 00-.035 1.06l1.5 1.5a.75.75 0 001.06-.001l3-3a.75.75 0 10-1.06-1.06L7.81 13.23l-.965-.965a.75.75 0 00-1.06.035zM12.5 6.5a.75.75 0 000 1.5h2a.75.75 0 000-1.5h-2zm-7 0a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5z" clip-rule="evenodd" />
      </svg>
      Stocks
    <% end %>
  </nav>

  <div class="border-t border-gray-800 p-3 shrink-0">
    <div class="flex items-center px-3 py-2 mb-1">
      <div class="w-7 h-7 bg-indigo-500 rounded-full flex items-center justify-center text-white text-xs font-bold shrink-0">
        <%= (current_user.first_name || current_user.email).first.upcase %>
      </div>
      <span class="ml-2.5 text-sm text-gray-300 truncate"><%= current_user.first_name || current_user.email %></span>
    </div>
    <%= button_to destroy_user_session_path, method: :delete,
        class: "w-full flex items-center px-3 py-2 text-sm font-medium text-gray-400 hover:bg-gray-800 hover:text-white rounded-lg transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-3 shrink-0">
        <path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd" />
        <path fill-rule="evenodd" d="M19 10a.75.75 0 00-.75-.75H8.704l1.048-.943a.75.75 0 10-1.004-1.114l-2.5 2.25a.75.75 0 000 1.114l2.5 2.25a.75.75 0 101.004-1.114l-1.048-.943h9.546A.75.75 0 0019 10z" clip-rule="evenodd" />
      </svg>
      Sign out
    <% end %>
  </div>
</aside>
