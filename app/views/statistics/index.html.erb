<% content_for :title, "Statistics" %>

<div class="mb-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Statistics</h1>
    <% if @selected_month %>
      <p class="mt-1 text-sm text-gray-500">Showing data for <span class="font-medium text-gray-700"><%= @selected_month.strftime('%B %Y') %></span></p>
    <% else %>
      <p class="mt-1 text-sm text-gray-500">Select a month to view your data</p>
    <% end %>
  </div>

  <%# Month + Year picker %>
  <% current_year = Date.today.year %>
  <% years = (2020..current_year + 1).to_a.reverse %>
  <% months = Date::MONTHNAMES.compact.each_with_index.map { |name, i| [name, i + 1] } %>
  <%= form_with url: statistics_path, method: :get, class: "mb-8" do |f| %>
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <%= f.select :month,
            options_for_select(months, params[:month].to_i),
            { include_blank: "Month" },
            class: "appearance-none pl-4 pr-4 py-3 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
      <%= f.select :year,
            options_for_select(years, params[:year].to_i.nonzero? || current_year),
            {},
            class: "appearance-none pl-4 pr-4 py-3 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
      <%= f.submit "View", class: "px-4 py-3 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors cursor-pointer" %>
    </div>
  <% end %>

  <% if @selected_month.nil? %>
    <div class="bg-white rounded-xl border border-gray-200 p-16 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-indigo-50 flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6 text-indigo-500">
          <path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="text-gray-700 font-medium">Pick a month to get started</p>
      <p class="mt-1 text-sm text-gray-400">Use the picker above to see your sales for that month</p>
    </div>

  <% elsif @sold_products.empty? %>
    <div class="bg-white rounded-xl border border-gray-200 p-16 text-center">
      <p class="text-gray-700 font-medium">No sales in <%= @selected_month.strftime('%B %Y') %></p>
      <p class="mt-1 text-sm text-gray-400">Try a different month.</p>
    </div>

  <% else %>
    <%# Summary cards %>
    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Paid</p>
        <p class="mt-1.5 text-2xl font-bold text-gray-900"><%= number_to_currency(@paid, unit: '') %></p>
        <p class="mt-1 text-xs text-gray-400">cost of items sold</p>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Revenue</p>
        <p class="mt-1.5 text-2xl font-bold text-gray-900"><%= number_to_currency(@revenue, unit: '') %></p>
        <p class="mt-1 text-xs text-gray-400"><%= @sold_products.size %> items sold</p>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Profit</p>
        <p class="mt-1.5 text-2xl font-bold <%= @profit >= 0 ? 'text-emerald-600' : 'text-red-600' %>">
          <%= number_to_currency(@profit, unit: '') %>
        </p>
        <% margin = @revenue > 0 ? (@profit / @revenue * 100).round(1) : 0 %>
        <p class="mt-1 text-xs text-gray-400"><%= margin %>% margin</p>
      </div>
    </div>

    <%# Chart %>
    <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-sm font-semibold text-gray-700 mb-4">Paid vs Revenue</h2>
      <div class="h-36 sm:h-56">
        <canvas data-controller="chart"
                data-chart-labels-value="<%= ['Paid', 'Revenue'].to_json %>"
                data-chart-invested-value="<%= [@paid].to_json %>"
                data-chart-revenue-value="<%= [@revenue].to_json %>"
                data-chart-total-invested-value="<%= @paid %>"
                data-chart-total-revenue-value="<%= @revenue %>"></canvas>
      </div>
      <div class="flex items-center gap-6 mt-4 justify-center">
        <span class="flex items-center gap-2 text-sm text-gray-500">
          <span class="w-3 h-3 rounded-full bg-indigo-500 inline-block"></span> Paid
        </span>
        <span class="flex items-center gap-2 text-sm text-gray-500">
          <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Revenue
        </span>
      </div>
    </div>

    <%# Items sold this month %>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Items sold in <%= @selected_month.strftime('%B %Y') %></h2>
      </div>

      <%# Mobile cards %>
      <div class="sm:hidden divide-y divide-gray-100">
        <% @sold_products.each do |product| %>
          <div class="p-4">
            <div class="flex items-start justify-between mb-2">
              <div>
                <p class="font-medium text-gray-900 text-sm"><%= product.description || product.prod_code %></p>
                <p class="text-xs text-gray-400 mt-0.5"><%= product.stock.description %></p>
              </div>
              <span class="text-sm font-semibold text-emerald-600"><%= number_to_currency(product.out_price, unit: '') %></span>
            </div>
            <div class="flex gap-4 text-xs text-gray-500">
              <span>Paid <span class="font-medium text-gray-700"><%= number_to_currency(product.in_price, unit: '') %></span></span>
              <% item_profit = (product.out_price || 0) - (product.in_price || 0) %>
              <span>Profit <span class="font-medium <%= item_profit >= 0 ? 'text-emerald-600' : 'text-red-600' %>"><%= number_to_currency(item_profit, unit: '') %></span></span>
            </div>
          </div>
        <% end %>
      </div>

      <%# Desktop table %>
      <div class="hidden sm:block overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50">
              <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Item</th>
              <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Stock</th>
              <th class="text-right px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Paid</th>
              <th class="text-right px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Sold for</th>
              <th class="text-right px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Profit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @sold_products.each do |product| %>
              <% item_profit = (product.out_price || 0) - (product.in_price || 0) %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-5 py-3.5">
                  <p class="font-medium text-gray-900"><%= product.description || '—' %></p>
                  <p class="text-xs text-gray-400"><%= product.prod_code %></p>
                </td>
                <td class="px-5 py-3.5 text-gray-500"><%= product.stock.description %></td>
                <td class="px-5 py-3.5 text-right text-gray-700"><%= number_to_currency(product.in_price, unit: '') %></td>
                <td class="px-5 py-3.5 text-right text-gray-700"><%= number_to_currency(product.out_price, unit: '') %></td>
                <td class="px-5 py-3.5 text-right font-medium <%= item_profit >= 0 ? 'text-emerald-600' : 'text-red-600' %>">
                  <%= number_to_currency(item_profit, unit: '') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
