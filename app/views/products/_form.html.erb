<%= form_with(model: product, html: { class: "space-y-5 min-w-0" }) do |form| %>
  <% if product.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <p class="text-sm font-medium text-red-800 mb-1"><%= pluralize(product.errors.count, "error") %> <%= t("products.errors.header") %></p>
      <ul class="text-sm text-red-700 list-disc list-inside space-y-0.5">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :description, t("stock.description"), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :description, class: "block w-full px-3 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :purchase_price, t("products.purchase_price"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <p class="text-xs text-gray-400 mb-1 invisible">·</p>
      <%= form.number_field :in_price, step: '0.01', class: "block w-full px-3 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :sale_price, t("products.sale_price"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <p class="text-xs text-gray-400 mb-1"><%= t("products.fill_when_sold") %></p>
      <%= form.number_field :out_price, step: '0.01', class: "block w-full px-3 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :size, t("products.size"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <p class="text-xs text-gray-400 mb-1"><%= t("products.optional") %></p>
      <%= form.text_field :size, class: "block w-full px-3 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :product_code, t("products.product_code"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <p class="text-xs text-gray-400 mb-1"><%= t("products.auto_generated") %></p>
      <%= form.text_field :prod_code, placeholder: t("products.code_placeholder"), class: "block w-full px-3 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
  </div>

  <% if product.stock_id %>
    <%= form.hidden_field :stock_id %>
  <% else %>
    <div>
      <%= form.label :stock_id, t("stocks.breadcrumb"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :stock_id, Stock.all, :id, :description, { include_blank: t("products.select_stock") }, { class: "block w-full px-3 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white" } %>
    </div>
  <% end %>

  <div class="flex items-start gap-3 py-1">
    <%= form.check_box :exclude_from_stats, class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
    <div>
      <%= form.label :exclude_from_stats, t("products.exclude_from_stats"), class: "block text-sm font-medium text-gray-700 cursor-pointer" %>
      <p class="text-xs text-gray-400"><%= t("products.exclude_from_stats_hint") %></p>
    </div>
  </div>

  <div class="pt-1">
    <%= form.submit product.new_record? ? t("products.submit_create") : t("products.submit_update"),
        class: "w-full flex justify-center py-3 px-4 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors cursor-pointer" %>
  </div>
<% end %>
