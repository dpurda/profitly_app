<div>
  <div class="flex justify-center pt-3 pb-1 sm:hidden">
    <div class="w-10 h-1.5 bg-gray-200 rounded-full"></div>
  </div>

  <div class="px-6 pt-4 pb-6" style="padding-bottom: max(1.5rem, env(safe-area-inset-bottom))">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-semibold text-gray-900"><%= t("passwords.title") %></h2>
    <button onclick="closePasswordModal()" type="button" class="text-gray-400 hover:text-gray-600 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
        <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
      </svg>
    </button>
  </div>

  <% if user.errors.any? %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm">
      <% user.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: change_user_password_path, method: :patch do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :current_password, t("passwords.current"), class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :current_password, name: "user[current_password]",
            class: "w-full px-3 py-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent",
            autocomplete: "current-password" %>
      </div>
      <div>
        <%= f.label :password, t("passwords.new"), class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password, name: "user[password]",
            class: "w-full px-3 py-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent",
            autocomplete: "new-password" %>
      </div>
      <div>
        <%= f.label :password_confirmation, t("passwords.confirm"), class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password_confirmation, name: "user[password_confirmation]",
            class: "w-full px-3 py-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent",
            autocomplete: "new-password" %>
      </div>
    </div>

    <div class="mt-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
      <button type="button" onclick="closePasswordModal()"
              class="w-full sm:w-auto px-4 py-3 sm:py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
        <%= t("passwords.cancel") %>
      </button>
      <%= f.submit t("passwords.submit"),
          class: "w-full sm:w-auto px-4 py-3 sm:py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
  </div>
</div>
